# LLM & Embeddings Settings (Ollama)
LLM_MODEL=llama3:8b
EMBEDDINGS_MODEL=nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434
LLM_TIMEOUT=120

# Documents Directory
DOCS_DIR=./docs

# Contextual Chunking Parameters
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# Retrieval & Reranking Parameters
RETRIEVAL_K=10
RERANKER_TOP_N=3

# Chat History Limit
MAX_HISTORY=10

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
